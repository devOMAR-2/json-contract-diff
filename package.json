{
  "name": "json-contract-diff",
  "version": "1.0.0",
  "description": "Detect breaking and non-breaking changes between the structure of two JSON values. Compares shapes and types, not values.",
  "keywords": [
    "json",
    "contract",
    "diff",
    "schema",
    "breaking-changes",
    "api",
    "compatibility",
    "structure",
    "shape",
    "ci",
    "cli"
  ],
  "license": "MIT",
  "author": "Omar Alfarraj <omar.alfarraj@yahoo.com> (https://github.com/devOMAR-2)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devOMAR-2/json-contract-diff.git"
  },
  "bugs": {
    "url": "https://github.com/devOMAR-2/json-contract-diff/issues"
  },
  "homepage": "https://github.com/devOMAR-2/json-contract-diff#readme",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "json-contract-diff": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/clean.js && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test:coverage && npm run build",
    "prepublishOnly": "npm run check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.19.43",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^4.1.11"
  }
}
